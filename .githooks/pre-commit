#!/bin/bash

set -euo pipefail

if [[ -n "${SKIP_SCREENSHOTS:-}" ]]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

if ! git diff --cached --name-only --diff-filter=ACMR \
  | grep -qE '^(Sources/ClaudeUsage/.+\.swift|Package\.swift|screenshots\.sh)$'; then
  exit 0
fi

log="$(mktemp)"
trap 'rm -f "${log}"' EXIT

echo "pre-commit: re-rendering docs/screenshots"
if ! ./screenshots.sh >"${log}" 2>&1; then
  cat "${log}" >&2
  echo "pre-commit: screenshot render failed, commit aborted." >&2
  echo "            Needs a window server — over SSH: SKIP_SCREENSHOTS=1 git commit ..." >&2
  exit 1
fi

# -A so a renamed or dropped image leaves the index too.
git add -A docs/screenshots

if git diff --cached --quiet -- docs/screenshots; then
  echo "pre-commit: screenshots unchanged"
else
  echo "pre-commit: screenshots updated and staged"
fi
